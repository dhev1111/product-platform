{
  "name": "product-platform",
  "version": "0.1.0",
  "description": "Free product build, test, release, deployment and monitoring platform",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "main": "dist/index.js",
  "types": "dist/index.js",
  "bin": {
    "product-platform": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node dist/cli/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2",
    "vitest": "^3.0.0"
  }
}
